{
  "name": "decha",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @decha/web",
    "dev:admin": "npm run dev --workspace @decha/admin",
    "build": "npm run build --workspace @decha/web && npm run build --workspace @decha/admin",
    "build:web": "npm run build --workspace @decha/web",
    "build:admin": "npm run build --workspace @decha/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
